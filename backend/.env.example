# Copy this to .env on VPS and fill in real values
# NEVER commit .env (it's in .gitignore)

# --- Server ---
PORT=3001
NODE_ENV=production

# --- Database (localhost only on VPS) ---
DATABASE_URL=postgresql://eznihongo_app:REPLACE_WITH_REAL_PASSWORD@localhost:5432/eznihongo

# --- JWT (generate with: openssl rand -base64 64) ---
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHARS

# --- Google OAuth (from Google Cloud Console) ---
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# --- Admin access (comma-separated emails) ---
ADMIN_EMAILS=rickysatoru@gmail.com

# --- CORS ---
# Include https://app.eznihongo.com so the Kanji PWA can call /api.
ALLOWED_ORIGINS=https://eznihongo.com,https://www.eznihongo.com,https://app.eznihongo.com

# --- Cookie config ---
COOKIE_DOMAIN=.eznihongo.com
COOKIE_SECURE=true

# --- Midtrans (Kanji PWA subscription) ---
# Sandbox: app.sandbox.midtrans.com. Production: app.midtrans.com.
MIDTRANS_BASE=https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
# Client key is exposed in kanji.html (inject via template or hard-code).
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
# Used for the Snap `finish` callback URL.
APP_URL=https://app.eznihongo.com

# --- Notion import (optional) ---
# Dipakai tombol "Import dari Notion" di admin (Kelola Deck → Dari bank) untuk
# narik database "📚 Vocabulary 語彙" ke bank kosakata. NOTION_TOKEN = Internal
# Integration Secret dari notion.so/my-integrations, lalu share database itu ke
# integration tsb. NOTION_VOCAB_DB_ID = ID/URL database vocabulary Notion.
NOTION_TOKEN=
NOTION_VOCAB_DB_ID=bd1f0d912aa24b139b5e68f3610b7c51
# Notion DB "📖 Kanji" — dipakai admin button "Import Kanji dari Notion" untuk
# narik karakter + reading + meaning + mnemonic ke tabel kanji_items. Properti
# yang dicari di tiap row: Kanji 漢字 (title), On 音読み, Kun 訓読み, Indonesian,
# Mnemonic, Stroke Count (number), Lesson (relation ke Bab). Kosong → admin
# import button disabled, kanji bisa diisi manual via admin form.
NOTION_KANJI_DB_ID=
# Curator page Notion buat section structure Daftar Kanji per level (mirror
# NOTION_<SLUG>_PAGE_ID untuk vocab). Format: paragraph bold = section name,
# bulleted list item dengan Kode Bab (N5-01, N5-02, ...) = anggota section.
# Kosong → fallback ke flat list per bab_kode.
NOTION_KANJI_N5_PAGE_ID=

# --- TTS / ElevenLabs (optional) ---
# Dipakai endpoint GET /api/tts untuk audio pelafalan "deck" kosakata. Hasilnya
# di-cache di tabel tts_cache (Postgres) jadi API ElevenLabs cuma dipanggil 1x
# per string unik. Kalau ELEVENLABS_API_KEY / ELEVENLABS_VOICE_ID kosong,
# endpoint balas 503 dan frontend fallback ke Web Speech browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Dialog-style listening quiz JLPT format. Backend auto-detect 3 role
# di audio_script:
#   N: ... → narrator (baca soal/mondai/pertanyaan)
#   A: ... → cewe (female dialog speaker)
#   B: ... → cowo (male dialog speaker)
# Per turn di-generate dengan voice yang sesuai lalu di-concat jadi 1 MP3.
# Kalau ada env yang kosong, fallback ke ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Backup (optional) ---
# Kalau di-set, backend/deploy/backup.sh akan rclone copy dump harian ke remote
# ini. Format: <rclone-remote-name>:<bucket>. Kosongkan untuk backup lokal saja.
# Contoh: RCLONE_REMOTE=r2:eznihongo-backups
RCLONE_REMOTE=
