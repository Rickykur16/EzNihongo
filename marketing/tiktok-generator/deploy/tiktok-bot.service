# Bot Telegram generator TikTok (/ide, /buat <n>, /render).
# Pasang:  sudo cp deploy/tiktok-bot.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now tiktok-bot
# Log:     journalctl -u tiktok-bot -f
# Sesuaikan WorkingDirectory dengan lokasi repo di server. Sebaiknya jalankan
# sebagai user biasa (isi User=), bukan root.
[Unit]
Description=EzNihongo TikTok generator bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/eznihongo/marketing/tiktok-generator
ExecStart=/usr/bin/env node src/cli.mjs bot
Restart=always
RestartSec=10
# User=

[Install]
WantedBy=multi-user.target
