# Salin jadi .env lalu isi.

# --- Claude (riset + naskah) ---
ANTHROPIC_API_KEY=
# ID model Claude untuk MENULIS NASKAH (menentukan kualitas hook & alur video).
CONTENT_MODEL=
# Opsional: model untuk RISET ide/berita & pemindaian harian (boleh lebih murah).
# Kosong = pakai CONTENT_MODEL. Riset naskah (/buat, /topik) juga memakai model ini.
RESEARCH_MODEL=
# Server-side fallback saat model menolak permintaan. "off" untuk mematikan.
CONTENT_FALLBACKS=default

# --- ElevenLabs (suara) ---
ELEVENLABS_API_KEY=
# Kosongkan untuk dicari otomatis: model yang id/namanya memuat ELEVENLABS_MODEL_HINT.
ELEVENLABS_MODEL=
ELEVENLABS_MODEL_HINT=v4
# Kosongkan untuk dicari otomatis berdasarkan nama suara.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Jessica
ELEVENLABS_STABILITY=0.35
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.05

# --- Foto stok (gratis untuk komersial). Pixabay dipakai lebih dulu bila diisi. ---
# Key Pixabay: daftar di pixabay.com lalu buka pixabay.com/api/docs (key tampil di halaman itu).
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Opsional: lokasi Chromium bila tidak memakai bawaan Playwright ---
CHROMIUM_PATH=

# --- Telegram (opsional: kirim ide/naskah/video + terima /ide, /buat, /render) ---
# Boleh bot yang sama dengan notifikasi admin backend, asalkan bot itu tidak memakai webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=1023651346

# --- Render di GitHub Actions (disarankan di VPS kecil) ---
# Kalau dua baris ini diisi, /render hanya menyiapkan suara + foto di VPS, lalu render
# (Chromium + ffmpeg, berat) dijalankan workflow .github/workflows/tiktok-render.yml.
# Video dikirim ke Telegram otomatis setelah selesai. Kosong = render di mesin ini.
# Token: GitHub → Settings → Developer settings → Fine-grained tokens → repo EzNihongo saja,
# izin "Actions: Read and write". Jangan pakai token classic dengan akses semua repo.
GITHUB_RENDER_TOKEN=
GITHUB_RENDER_REPO=Rickykur16/EzNihongo

# --- Bersih-bersih folder out/ ---
# Setiap video terkirim ke Telegram, file berat (suara, foto, video, sisa render) dari folder
# video yang lebih tua dari sekian hari dihapus. Naskah & review (teks) tetap disimpan.
OUT_KEEP_DAYS=14
